{
  "name": "ieltsyn",
  "productName": "IELTS Studyroom",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite",
    "speaking:dev": "vite speaking-app --config speaking-app/vite.config.js --host 127.0.0.1 --port 5174 --strictPort",
    "speaking:build": "vite build speaking-app --config speaking-app/vite.config.js --outDir dist",
    "speaking:desktop": "npm run speaking:build && electron desktop/speaking-main.mjs",
    "speaking:package:mac": "npm run speaking:build && electron-builder --config speaking-builder.config.cjs --mac --arm64",
    "build": "vite build",
    "preview": "vite preview",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "package:mac": "npm run build && electron-builder --mac dir --arm64",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "desktop:start": "npm run build && electron .",
    "check": "node scripts/check-project.mjs && node --test tests/*.test.mjs",
    "postinstall": "node node_modules/electron/install.js",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@phosphor-icons/react": "2.1.10",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.2.108",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.180.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.5",
    "electron": "43.8.12",
    "electron-builder": "26.18.0",
    "png-to-ico": "3.0.2",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "com.ielts.studyroom",
    "productName": "IELTS Studyroom",
    "asar": true,
    "asarUnpack": [
      "dist/media/**/*",
      "dist/resources/**/*"
    ],
    "directories": {
      "output": "release/build",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "IELTS Studyroom",
      "artifactName": "IELTS-Studyroom-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.iconset/icon_512x512@2x.png",
      "category": "public.app-category.education",
      "artifactName": "IELTS-Studyroom-${version}-${arch}.${ext}",
      "identity": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "IELTS Studyroom",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "runAfterFinish": true
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ]
  },
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "overrides": {
    "minimatch@9": "11.0.1",
    "minimatch@10": "11.0.1"
  },
  "license": "MIT",
  "description": "Two local-first IELTS practice apps with optional user-supplied Alibaba Bailian AI."
}
